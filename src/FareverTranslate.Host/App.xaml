<Application x:Class="FareverTranslate.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#E9191D26" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FFADB6C6" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#FF334155" />
      <Setter Property="BorderBrush" Value="#FF475569" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="CompactActionButton"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CompactDismissButton"
           TargetType="Button"
           BasedOn="{StaticResource CompactActionButton}">
      <Setter Property="Foreground" Value="#FF9BA7B8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
  </Application.Resources>
</Application>
