<Window x:Class="FareverTranslate.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farever Translate"
        Width="360"
        Height="280"
        MinWidth="320"
        MinHeight="220"
        MaxWidth="620"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Opacity="0"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
  <Border x:Name="PanelBorder"
          CornerRadius="14"
          BorderThickness="1"
          BorderBrush="#CC475569"
          Background="{StaticResource PanelBrush}"
          Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="DragHeader"
            MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Farever Translate"
                     Foreground="White"
                     FontSize="16"
                     FontWeight="Bold" />
          <TextBlock x:Name="ReaderState"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Clave"
                Margin="6,0,0,0"
                Click="ApiKey_Click" />
        <Button x:Name="CalibrationButton"
                Grid.Column="2"
                Content="Calibrar"
                Margin="6,0,0,0"
                Click="Calibration_Click" />
        <Button Grid.Column="3"
                Content="×"
                FontSize="17"
                Margin="6,0,0,0"
                ToolTip="Ocultar (Ctrl+Shift+T)"
                Click="Hide_Click" />
      </Grid>
      <TextBlock x:Name="CalibrationHint"
                 Grid.Row="1"
                 Margin="0,9,0,4"
                 Foreground="#FFFBBF24"
                 Text="Arrastrá desde el título y tocá Listo al terminar."
                 Visibility="Collapsed" />
      <ScrollViewer Grid.Row="2"
                    Margin="0,8,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource CardBrush}"
                      CornerRadius="9"
                      Padding="10"
                      Margin="0,0,0,7">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="{Binding Sender}"
                               Foreground="#FFBFDBFE"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Channel, StringFormat= · {0}}"
                               Foreground="{StaticResource MutedBrush}" />
                  </DockPanel>
                  <TextBlock Text="{Binding Original}"
                             Foreground="White"
                             TextWrapping="Wrap"
                             MaxHeight="44"
                             Margin="0,4,0,5" />
                  <TextBlock Text="{Binding Translation}"
                             Foreground="#FFBBF7D0"
                             TextWrapping="Wrap"
                             Margin="0,1,0,4" />
                  <DockPanel LastChildFill="True">
                    <Button Content="{Binding ButtonText}"
                            IsEnabled="{Binding CanTranslate}"
                            Tag="{Binding}"
                            HorizontalAlignment="Left"
                            Click="Translate_Click" />
                    <TextBlock Text="{Binding Status}"
                               Foreground="#FFFCA5A5"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0"
                               TextWrapping="Wrap" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="EmptyState"
                 Grid.Row="2"
                 Margin="8,28"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Foreground="{StaticResource MutedBrush}"
                 Text="Esperando mensajes de otros jugadores…" />
      <TextBlock Grid.Row="3"
                 Margin="0,5,0,0"
                 Foreground="#FF7F8A9C"
                 FontSize="10"
                 Text="Traducción manual · destino español · Ctrl+Shift+T" />
      <ResizeGrip Grid.Row="3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Width="16"
                  Height="16"
                  Margin="0,0,-7,-7"
                  Panel.ZIndex="10" />
    </Grid>
  </Border>
</Window>
